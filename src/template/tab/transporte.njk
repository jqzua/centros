{% import "macros.njk" as m %}
{{ m.header("Transporte") }}
<div class="content">
  <p class="muted">Muestra en el mapa las líneas de transporte que te interesen.</p>
  <div class="card mt-3 p-3">
    {{ m.check("estaciones", "Mostrar también las estaciones de las líneas elegidas") }}
  </div>
  {% for grupo, titulo in [["metro", "Metro"], ["cercanias", "Cercanías"], ["metro_ligero", "Metro ligero"]] %}
  <fieldset class="{{ grupo }}">
    <legend>{{ titulo }}</legend>
    <div class="opt-grid">
    {% for t in transporte[grupo] %}
      <label class="opt-pill" for="{{ grupo }}_{{ t.linea }}" title="{{ titulo }} línea {{ t.linea }}">
        <input id="{{ grupo }}_{{ t.linea }}" type="checkbox"/>
        <span class="swatch" style="background-color: {{ t.color }}"></span>{{ t.linea }}
      </label>
    {% endfor %}
    </div>
  </fieldset>
  {% endfor %}
  <p class="muted mt-3">La ubicación de las estaciones es orientativa y puede haber accesos que no aparezcan.</p>
  {% include "tab/donar.njk" %}
</div>
