{% import "macros.njk" as m %}
{{ m.header("Mandar un correo") }}
<div class="content">
  <div class="card mt-1 p-4">
    <p class="mb-3">Escribe a la vez a todos los centros que se están mostrando en el mapa (en copia oculta).</p>
    <a href="#" id="maillink" class="btn btn-primary w-full">{{ icon("enviar") }} Escribir a los centros visibles</a>
  </div>
  <p class="muted mt-3">En {{ icon("lista", "h-3.5 w-3.5 align-[-2px]") }} Tu lista también puedes escribir a cada grupo de centros por separado.</p>
  {% include "tab/donar.njk" %}
</div>
